# Copy this file to ".env" and fill in real values. Never commit ".env" itself.

# Must match DEVICE_SECRET in firmware.ino exactly
DEVICE_SECRET=change-this-to-a-long-random-string

# Your login (only one user - you). Set a strong password.
AUTH_USERNAME=hamza
AUTH_PASSWORD=change-this-to-a-strong-password

# Random long string used to sign login tokens
JWT_SECRET=change-this-to-another-long-random-string

# Port the server listens on (hosting platforms usually set this for you)
PORT=3000
